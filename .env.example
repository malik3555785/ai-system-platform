# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_LOG_LEVEL=INFO

# External API Configuration
EXTERNAL_API_BASE_URL=https://apis.davidcyril.name.ng
EXTERNAL_API_TIMEOUT=30
EXTERNAL_API_RETRY_ATTEMPTS=3

# Model Configuration
GPT5_API_KEY=your_gpt5_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
DEFAULT_MODEL=gpt-4
MODEL_TIMEOUT=30

# Database Configuration
DATABASE_URL=sqlite:///./data/ai_system.db
DATABASE_POOL_SIZE=10
DATABASE_ECHO=False

# Cache Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Authentication
AUTH_SECRET_KEY=your_super_secret_key_change_me_in_production
AUTH_ALGORITHM=HS256
AUTH_EXPIRATION_HOURS=24
JWT_SECRET_KEY=your_jwt_secret_key_here

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_FILE=logs/ai_system.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Monitoring
MONITORING_ENABLED=True
MONITORING_PROMETHEUS_PORT=9090

# System
SYSTEM_NAME=AI-System-Platform
SYSTEM_VERSION=2.0.0
ENVIRONMENT=development

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:3000"]
